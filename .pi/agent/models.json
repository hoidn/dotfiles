{
  // Mirrors ~/.omp/agent/models.yml. API keys are resolved at runtime from
  // omp's auth DB via command references, so no secret lives in this file.
  "providers": {
    "openrouter": {
      "apiKey": "!sqlite3 /home/ollie/.omp/agent/agent.db \"select json_extract(data,'$.key') from auth_credentials where provider='openrouter' and credential_type='api_key' limit 1\""
    },
    "deepseek": {
      "apiKey": "!sqlite3 /home/ollie/.omp/agent/agent.db \"select json_extract(data,'$.key') from auth_credentials where provider='deepseek' and credential_type='api_key' limit 1\""
    },
    "zai": {
      "apiKey": "!sqlite3 /home/ollie/.omp/agent/agent.db \"select json_extract(data,'$.key') from auth_credentials where provider='zai' and credential_type='api_key' limit 1\""
    }
  }
}
