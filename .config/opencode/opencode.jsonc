{
  "$schema": "https://opencode.ai/config.json",

  // OMP modelRoles.default
  "model": "anthropic/claude-fable-5",

  // OpenCode uses this for internal lightweight operations.
  // Delegated exploration is configured separately below.
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",

  "default_agent": "build",
  "subagent_depth": 1,

  "agent": {
    // OMP: default = anthropic/claude-fable-5:max
    "build": {
      "description": "Main coordinator and final integrator",
      "mode": "primary",
      "model": "anthropic/claude-fable-5",
      "variant": "max",
      "prompt": "Act as the main coordinator and final integrator. Use general for delegated implementation, explore or scout for inexpensive research, and advisor for independent review of consequential plans or implementations. Evaluate all delegated output yourself and perform final verification.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "scout": "allow",
          "advisor": "allow"
        }
      }
    },

    // OMP: plan = openai-codex/gpt-5.6-sol:max
    "plan": {
      "description": "High-effort read-only planning mode",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "max",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow",
          "advisor": "allow"
        }
      }
    },

    // OMP: slow = openai-codex/gpt-5.6-sol:max
    "slow": {
      "description": "Maximum-effort primary mode for difficult tasks",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "max",
      "prompt": "Handle difficult reasoning, design, and integration tasks with maximum effort. Delegate bounded work where useful, but personally evaluate evidence and verify the final result.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "scout": "allow",
          "advisor": "allow"
        }
      }
    },

    // OMP: task = openrouter/deepseek/deepseek-v4-pro-0813:high
    //
    // OpenCode's built-in general subagent is the closest equivalent:
    // full-access, multi-step delegated work.
    "general": {
      "description": "Implements bounded delegated coding tasks",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-pro-0813",
      "variant": "high",
      "prompt": "Implement the delegated task autonomously. Inspect existing conventions, make focused changes, preserve unrelated work, and run appropriate tests. Report files changed, verification results, unresolved failures, and uncertain assumptions.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "external_directory": "deny"
      }
    },

    // OMP: smol = openrouter/deepseek/deepseek-v4-flash-0731:medium
    //
    // explore handles local codebase searches.
    "explore": {
      "description": "Fast read-only local codebase exploration",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "variant": "medium",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },

    // OpenCode distinguishes external research from local exploration.
    // Both map to OMP's smol role.
    "scout": {
      "description": "Fast external documentation and dependency research",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "variant": "medium",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },

    // OMP: advisor = anthropic/claude-fable-5:max
    "advisor": {
      "description": "Independent architecture and code reviewer for consequential decisions and completed implementations",
      "mode": "subagent",
      "model": "anthropic/claude-fable-5",
      "variant": "max",
      "prompt": "Act as an independent senior reviewer. Do not modify files. Examine requirements, plans, diffs, surrounding code, and tests. Identify correctness errors, requirement mismatches, unsafe assumptions, architectural problems, regressions, and missing tests. Rank findings by severity and include exact file references. Do not invent criticism when the work is sound.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": "deny"
      }
    }
  },

  // Mirrors ~/.omp/agent/models.yml: pin OpenRouter upstreams for cache affinity.
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro-0813": {
          "options": { "provider": { "only": ["gmicloud"], "allow_fallbacks": false } }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": { "provider": { "only": ["novita"], "allow_fallbacks": false } }
        }
      }
    },

    // GLM Coding Plan (glm-5.3). Auth: `opencode auth login` -> Z.ai Coding Plan.
    "zai-coding-plan": {}
  }
}
